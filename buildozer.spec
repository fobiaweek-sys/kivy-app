[app]

# (str) Title of your application
title = Love You, Iris

# (str) Package name
package.name = loveyouiris

# (str) Package domain
package.domain = org.loveyouiris

# (str) Source code directory
source.dir = .

# (list) Source files to include
source.include_exts = py,png,jpg,kv,atlas

# (str) Application version
version = 1.0

# (list) Python requirements
requirements = python3,kivy

# (str) Orientation
orientation = portrait

# (bool) Fullscreen
fullscreen = 1

# (str) Android API
android.api = 33

# (str) Android minimum API
android.minapi = 21

# (str) Android NDK
android.ndk = 25b

# (str) Android SDK build tools version
android.build_tools_version = 33.0.3

# (str) Android architecture
android.archs = arm64-v8a,armeabi-v7a

# (bool) Android permissions
android.permissions =

# (str) Presplash
presplash.filename =

# (str) Icon
icon.filename =

[buildozer]

# (str) Log level
log_level = 2

# (bool) Warn if running as root
warn_on_root = 1
